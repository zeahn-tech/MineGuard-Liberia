rules_version = '2';

// ---------------------------------------------------------------------------
// MINEGUARD LIBERIA — FIRESTORE SECURITY RULES
//
// These rules are the authoritative server-side authorization boundary.
// They mirror the role/scope model enforced in the client data layer:
//
//   admin      — national oversight administrator: full staff access
//   supervisor — regional/county supervision: staff read + reviewer writes
//   inspector  — field officer: inspections, incidents, observations
//   operator   — mining operator: strict tenant isolation (own sites only)
//   public     — community report submission + tracking, landing-page counts
//
// The user's role/scope lives in /users/{uid} and is ADMIN-WRITABLE ONLY —
// a client can never elevate itself by editing its own profile doc.
//
// TENANT ISOLATION (corrected 2026-09-23): single-document reads (get) on
// findings, correctiveActions and evidence re-check site visibility via
// siteVisibleAt(), the same pattern as incidents and observations.
//
// LIST SCOPING (2026-09-23, closes doc 04 gap 5): list rules now enforce
// county/operator scope PER DOCUMENT using siteVisible(), which reads the
// denormalized county/operatorName stamped on every site-scoped record at
// write time. Firestore validates the query against these rules, so the data
// layer constrains county/operator queries with the matching filter
// (scopeConstraintForUser in src/lib/types.ts) — the constraint lives in one
// place and both layers enforce it.
//
// Evidence is the one exception to denormalization: its metadata is
// append-only (allow update: false), so county/operatorName cannot be stamped
// onto pre-existing rows. Its list rule therefore joins to the PARENT record
// (parentType + parentId, both constrained by the caller's query) and
// re-checks the parent site's visibility — fail-closed for foreign parents.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return profile().role;
    }

    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isSupervisor() { return signedIn() && role() == 'supervisor'; }
    function isInspector() { return signedIn() && role() == 'inspector'; }
    function isOperator() { return signedIn() && role() == 'operator'; }
    function isStaff() {
      return isAdmin() || isSupervisor() || isInspector();
    }
    function isReviewer() { return isAdmin() || isSupervisor(); }

    // Staff members see everything; county-scoped staff are filtered in the
    // data layer (and by convention when writing queries).
    function canReadStaffData() { return isStaff(); }

    function siteVisible() {
      return (
        isAdmin() ||
        (isStaff() && profile().scope == 'national') ||
        (isStaff() && profile().scope == 'county' && resource.data.county == profile().county) ||
        (isOperator() && resource.data.operatorName == profile().operatorName)
      );
    }

    function siteVisibleAt(siteRef) {
      return (
        isAdmin() ||
        (isStaff() && profile().scope == 'national') ||
        (isStaff() && profile().scope == 'county' && get(siteRef).data.county == profile().county) ||
        (isOperator() && get(siteRef).data.operatorName == profile().operatorName)
      );
    }

    // Evidence LIST join. Evidence metadata is append-only (allow update:
    // false), so unlike the other site-scoped collections it cannot carry a
    // denormalized county/operatorName stamp on rows that already exist. Its
    // list rule therefore joins parentType + parentId — the two fields the
    // caller's query is REQUIRED to constrain (evidence.listForParent filters
    // on exactly these, and Firestore rejects a query whose safety the rule
    // cannot prove) — to the parent record, then re-checks the parent site's
    // visibility. A caller who knows a foreign evidence doc's parent still
    // fails the site join, and a missing parent fails closed (get() error →
    // deny). Admin short-circuits first so admin tooling can read unconstrained.
    function parentEvidenceVisible() {
      return (
        isAdmin() ||
        (resource.data.parentType == 'inspection' &&
          siteVisibleAt(/databases/$(database)/documents/sites/$(get(/databases/$(database)/documents/inspections/$(resource.data.parentId)).data.siteId))) ||
        (resource.data.parentType == 'incident' &&
          siteVisibleAt(/databases/$(database)/documents/sites/$(get(/databases/$(database)/documents/incidents/$(resource.data.parentId)).data.siteId))) ||
        (resource.data.parentType == 'observation' &&
          siteVisibleAt(/databases/$(database)/documents/sites/$(get(/databases/$(database)/documents/environmentalObservations/$(resource.data.parentId)).data.siteId)))
      );
    }

    // ------------------------------------------------------------- helpers
    // PUBLIC REPORT RATE LIMIT (partial mitigation — see doc 04).
    // Each community-report submission must reference a per-minute bucket
    // document /rateLimits/cr-{unixMinute} that was incremented for it.
    // The rules enforce: bucket id == the CURRENT minute (request.time), the
    // counter only ever increments by exactly one, and the per-minute cap.
    // A determined adversary can still exhaust the global per-minute quota
    // (a honest limitation of rules-level limiting); a robust limiter needs a
    // Cloud Function gatekeeper.
    function currentMinute() {
      return string(request.time.toMillis() / 60000);
    }

    function reportBucketId() {
      return 'cr-' + currentMinute();
    }

    // ------------------------------------------------------------ /users
    match /users/{uid} {
      // Anyone may check whether any staff exists (first-run bootstrap
      // reads this via a limited query client-side through the rules below).
      // Profile docs: readable by the owner and by staff; creatable by the
      // owner on signup WITHOUT a role; role/scope fields admin-only.
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == null
        && request.resource.data.profileComplete == false;

      // Users may complete their own profile (jobTitle, organization, scope,
      // county, operatorName) but can NEVER write their own role unless no
      // staff exists yet (first-run bootstrap, email accounts only — not
      // anonymous guests). Admins may update any user (role provisioning).
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && (
            // Self-update without touching role
            request.resource.data.role == resource.data.role
            // First-run bootstrap: only when this doc would be the first staff
            || (
              request.resource.data.role in ['admin', 'supervisor', 'inspector']
              && !exists(/databases/$(database)/documents/meta/hasStaff)
              && resource.data.role == null
              && request.auth.token.firebase.sign_in_provider != 'anonymous'
            )
          )
        );

      allow delete: if isAdmin() && request.auth.uid != uid;

      // Listing users requires admin (page uses it for provisioning).
      // Firestore rules can't distinguish list vs get, so staff listing is
      // allowed but each doc is only readable per the read rule above —
      // operators/inspectors are also staff-readable.
      // (kept consistent: isStaff() can read all users)
    }

    // meta/hasStaff — set by the client data layer when the first staff
    // profile completes. Immutable after creation (no update/delete).
    match /meta/{docId} {
      allow get: if true;
      allow list: if true;
      // publicStats holds aggregate counts already public on the landing
      // page; writes are not privileged (worst case: cosmetic skew).
      // hasStaff is create-once by a signed-in, non-anonymous account.
      allow create: if docId == 'publicStats'
        || (
          signedIn()
          && docId == 'hasStaff'
          && !exists(/databases/$(database)/documents/meta/hasStaff)
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
        );
      allow update: if docId == 'publicStats';
      allow delete: if false;
    }

    // ------------------------------------------------------------- /sites
    match /sites/{siteId} {
      allow get: if signedIn() && siteVisible();
      // List enforces county/operator scope per document (doc 04 gap 5):
      // county-scoped staff must filter `county ==` and operators
      // `operatorName ==`; admins/national staff are unconstrained.
      allow list: if signedIn() && siteVisible();

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // sites are never deleted (data integrity)
    }

    // -------------------------------------------- /inspectionTemplates
    // Templates are non-sensitive form definitions; operators need them to
    // render inspection records that reference a template. The template
    // editor writes here (admin-only), per Directive §11.
    match /inspectionTemplates/{templateId} {
      allow read: if isStaff() || isOperator();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // deactivation (active:false) instead of delete
    }

    // ------------------------------------------------------ /inspections
    match /inspections/{inspectionId} {
      allow get: if signedIn() && (
        isStaff() ||
        (isOperator() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId)))
      );
      // List: county/operator scope enforced per document (doc 04 gap 5).
      allow list: if signedIn() && siteVisible();

      allow create: if isStaff()
        && request.resource.data.status == 'draft'
        && request.resource.data.inspectorId == request.auth.uid;

      // Only the owning inspector, and only while still a draft.
      allow update: if isStaff()
        && resource.data.inspectorId == request.auth.uid
        && resource.data.status == 'draft';

      // Reviewers move under_review -> approved/rejected.
      allow update: if isReviewer()
        && resource.data.status == 'under_review'
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if false;
    }

    // --------------------------------------------------------- /findings
    match /findings/{findingId} {
      // get is per-document tenant-scoped; list stays coarse (data layer
      // filters; doc 04 gap 5).
      allow get: if signedIn() && (
        isStaff() ||
        (isOperator() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId)))
      );
      // List: county/operator scope enforced per document (doc 04 gap 5).
      allow list: if signedIn() && siteVisible();

      allow create: if isStaff();

      // Operators may only acknowledge — and only on their own sites.
      allow update: if isStaff() || (
        isOperator()
        && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId))
        && request.resource.data.status == 'acknowledged'
        && resource.data.status == 'open'
      );
      allow delete: if false;
    }

    // ----------------------------------------------- /correctiveActions
    match /correctiveActions/{caId} {
      allow get: if signedIn() && (
        isStaff() ||
        (isOperator() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId)))
      );
      // List: county/operator scope enforced per document (doc 04 gap 5).
      allow list: if signedIn() && siteVisible();

      allow create: if isStaff();

      // Operator responds (note + status submitted) — own sites only;
      // reviewer decides.
      allow update: if isReviewer()
        || (
          isOperator()
          && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId))
          && resource.data.status in ['open', 'in_progress']
          && request.resource.data.status == 'submitted'
        );

      allow delete: if false;
    }

    // -------------------------------------------------------- /incidents
    match /incidents/{incidentId} {
      allow get: if signedIn() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId));
      // List: county/operator scope enforced per document (doc 04 gap 5).
      allow list: if signedIn() && siteVisible();

      allow create: if signedIn()
        && request.resource.data.status == 'reported'
        && siteVisibleAt(/databases/$(database)/documents/sites/$(request.resource.data.siteId));

      allow update: if isStaff()
        && request.resource.data.status in ['investigating', 'closed'];

      allow delete: if false;
    }

    // ------------------------- /environmentalObservations
    match /environmentalObservations/{obsId} {
      allow get: if signedIn() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId));
      // List: county/operator scope enforced per document (doc 04 gap 5).
      allow list: if signedIn() && siteVisible();

      allow create: if signedIn()
        && siteVisibleAt(/databases/$(database)/documents/sites/$(request.resource.data.siteId));

      allow update: if isStaff()
        && request.resource.data.status in ['open', 'monitoring', 'resolved'];

      allow delete: if false;
    }

    // --------------------------------------------- /communityReports
    // Public submission. The report doc is write-only to the public; the
    // tracking doc exposes only coarse status. A report is a concern —
    // never an automatic accusation of guilt.
    //
    // Rate-limit gate: the submit flow must first create/increment the
    // current-minute counter doc (see /rateLimits below) and carry its id in
    // rateBucket. Rules verify the bucket is the current minute and the
    // counter exists under the cap.
    match /communityReports/{reportId} {
      allow create: if request.resource.data.status == 'submitted'
        && request.resource.data.trackingCode is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.description.size() > 0
        && request.resource.data.rateBucket == reportBucketId()
        && exists(/databases/$(database)/documents/rateLimits/$(request.resource.data.rateBucket))
        && get(/databases/$(database)/documents/rateLimits/$(request.resource.data.rateBucket)).data.count <= 30;

      allow read: if isStaff();
      allow update: if isReviewer()
        && request.resource.data.status in ['under_review', 'verified', 'dismissed', 'referred'];
      allow delete: if false;
    }

    // --------------------------------------------- /reportTracking
    // Public read of coarse status by tracking code (unauthenticated).
    match /reportTracking/{trackingCode} {
      allow get: if true;
      allow create: if true; // written by the submit flow alongside the report
      allow update: if isReviewer();
      allow delete: if false;
    }

    // --------------------------------------------- /rateLimits
    // Per-minute counters gating the public report endpoint. NOT a robust
    // limiter: it stops unbounded flooding but a determined adversary can
    // exhaust the global per-minute quota, and clock skew at minute
    // boundaries can reject a legitimate report. Documented honestly in
    // doc 04; a Cloud Function gatekeeper is the planned full fix.
    match /rateLimits/{limitId} {
      allow get: if true; // submit flow pre-checks the counter client-side
      allow list: if false;

      allow create: if limitId == reportBucketId()
        && request.resource.data.count == 1
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      // Only the current-minute bucket may be incremented, exactly +1 at a
      // time, capped at 30 per minute.
      allow update: if limitId == reportBucketId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 30;

      allow delete: if false;
    }

    // --------------------------------------------------------- /evidence
    // Evidence metadata. siteId is MANDATORY at write time (the data layer
    // derives it from the parent record), so single-document reads are
    // tenant-scoped exactly like the parent records. The storagePath embeds
    // this doc id (evidence/{uid}/{docId}__{fileName}) so storage.rules can
    // join bytes to this metadata and re-derive the same check.
    match /evidence/{evidenceId} {
      allow get: if signedIn() && siteVisibleAt(/databases/$(database)/documents/sites/$(resource.data.siteId));
      // LIST scoping without denormalized fields: evidence metadata is
      // append-only, so the caller's scope is derived by joining to the PARENT
      // record (parentType + parentId are both constrained by the caller's
      // query) and re-checking that parent's site visibility. A caller who
      // knows a foreign evidence doc's parent still fails the site join.
      allow list: if signedIn() && parentEvidenceVisible();

      allow create: if signedIn()
        && request.resource.data.uploadedById == request.auth.uid
        && request.resource.data.siteId is string
        && request.resource.data.sizeBytes < 26214400; // 25MB
      allow update: if false;
      allow delete: if isAdmin(); // governance removal only
    }

    // -------------------------------------------------------- /auditLog
    // Append-only: any signed-in principal (including public submissions
    // attributing 'public') may create; nobody may modify or delete.
    match /auditLog/{entryId} {
      allow create: if true;
      allow read: if isStaff();
      allow update: if false;
      allow delete: if false;
    }
  }
}
